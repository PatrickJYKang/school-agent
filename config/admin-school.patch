diff --git a/src/school/schema.ts b/src/school/schema.ts
new file mode 100644
index 0000000..54a2a33
--- /dev/null
+++ b/src/school/schema.ts
@@ -0,0 +1,42 @@
+import { z } from 'zod/v3';
+import { configSchema as upstreamSchema } from 'librechat-data-provider';
+
+// This pinned panel uses Zod 3. These controls mirror the fork's server-validated policy;
+// unknown limits remain visible and are preserved by the panel's leaf-level updates.
+const school = z
+  .object({
+    enabled: z.boolean().optional(),
+    name: z.string().optional(),
+    guidance: z.string().optional(),
+    timeZone: z.string().optional(),
+    externalLinks: z.object({ enabled: z.boolean().default(true) }).optional(),
+    webSearch: z
+      .object({
+        enabled: z.boolean().default(true),
+        safeSearch: z.enum(['off', 'moderate', 'strict']).default('strict'),
+      })
+      .optional(),
+    documents: z.object({ enabled: z.boolean().default(false) }).optional(),
+    canvas: z
+      .object({
+        enabled: z.boolean().optional(),
+        toolCalling: z.boolean().optional(),
+        baseUrl: z.string().optional(),
+      })
+      .optional(),
+  })
+  .optional();
+
+// Normalize the object boundary across the two installed Zod 3 declaration versions.
+const base = upstreamSchema as unknown as z.AnyZodObject;
+const interfaceSchema = upstreamSchema.shape.interface.removeDefault() as unknown as z.AnyZodObject;
+const webSchema = upstreamSchema.shape.webSearch.unwrap() as unknown as z.AnyZodObject;
+export const configSchema = base.extend({
+  interface: interfaceSchema.extend({ school }).default({}),
+  webSearch: webSchema
+    .extend({
+      braveApiKey: z.string().optional().default('${BRAVE_SEARCH_API_KEY}'),
+      braveApiKeyPreview: z.string().optional(),
+    })
+    .optional(),
+});
diff --git a/src/school/schema.test.ts b/src/school/schema.test.ts
new file mode 100644
index 0000000..867800e
--- /dev/null
+++ b/src/school/schema.test.ts
@@ -0,0 +1,21 @@
+import { it, expect } from 'vitest';
+import { configSchema } from './schema';
+import { extractSchemaTree, flattenTree } from '@/server/config/schema';
+import type * as t from '@/types';
+
+it('exposes school link, document and Brave settings in the pinned panel schema', () => {
+  const fields = flattenTree(extractSchemaTree(configSchema as t.ZodSchemaLike));
+  expect(fields.map((field) => field.path)).toEqual(
+    expect.arrayContaining([
+      'interface.school.externalLinks.enabled',
+      'interface.school.webSearch.enabled',
+      'interface.school.documents.enabled',
+      'webSearch.braveApiKey',
+    ]),
+  );
+  expect(
+    configSchema.parse({ version: '1.3.18', interface: { school: { externalLinks: {} } } }),
+  ).toMatchObject({
+    interface: { school: { externalLinks: { enabled: true } } },
+  });
+});
